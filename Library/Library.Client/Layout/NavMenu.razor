<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            Библиотека <span class="bi bi-library-cat-nav-menu" aria-hidden="true"></span>
            </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-home-cat-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="readers">
                <span class="bi bi-cat-nav-menu" aria-hidden="true"></span> Читатели
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="books">
                <span class="bi bi-dancing-cat-nav-menu" aria-hidden="true"></span> Книги
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="loan-records">
                <span class="bi bi-angry-cat-nav-menu" aria-hidden="true"></span> Записи о выдачах
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
