                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/analytics/top-readers-by-loaned-books-count": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Retrieves the top readers who have borrowed the highest number of books within a specified date range.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "description": "Start date of the period (inclusive).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End date of the period (inclusive).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "resultCount",
            "in": "query",
            "description": "Maximum number of results to return. Defaults to 5.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReaderLoanCountDto"
