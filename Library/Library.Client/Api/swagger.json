  "components": {
    "schemas": {
      "BookCreateDto": {
        "required": [
          "authors",
          "code",
          "inventoryNumber",
          "publisher",
          "publisherType",
          "title",
          "year"
        ],
        "type": "object",
        "properties": {
          "inventoryNumber": {
            "type": "integer",
            "description": "Unique inventory number of the book assigned by the library.\r\nMust be non-null and unique across all books.",
            "format": "int32"
          },
          "code": {
            "type": "string",
            "description": "Catalog code identifying the book within the library's classification system.\r\nMust be non-null.",
            "nullable": true
          },
          "authors": {
            "type": "string",
            "description": "Full names of the book's authors, formatted as a comma-separated list if multiple.\r\nMust be not empty.",
            "nullable": true
          },
          "title": {
            "type": "string",
            "description": "Title of the book.\r\nMust be not null.",
            "nullable": true
          },
          "publisherType": {
            "type": "string",
            "description": "Type of publisher (e.g., Commercial, Academic, Educational).\r\nUsed to categorize the source and nature of the publication.\r\nMust match one of the supported publisher types.",
            "nullable": true
          },
          "publisher": {
            "type": "string",
            "description": "Name of the publishing house responsible for the book's release.\r\nShould correspond to an existing publisher in the library's records.",
            "nullable": true
          },
          "year": {
            "type": "integer",
            "description": "Year when the book was published.",
            "format": "int32"
          }
        },
        "additionalProperties": false,
